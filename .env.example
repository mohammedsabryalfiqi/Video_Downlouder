# ═══════════════════════════════════════════════════════════
#  Video Downloader Bot — الإعدادات
#  انسخ الملف: cp .env.example .env  ثم عدّل القيم
#  على Railway: ضع هذه المتغيرات في تبويب Variables
# ═══════════════════════════════════════════════════════════

# 🔑 توكن البوت من @BotFather (إجباري لتشغيل البوت)
BOT_TOKEN=1234567890:AAA...ضع_التوكن_هنا

# 👑 المالك — صلاحيات كاملة دائماً (تعيين/إزالة مشرفين، لا يُحظر أبداً)
#    هذا المعرف مُعدّ مسبقاً كمالك للبوت — غيّره لو احتجت
OWNER_ID=5231453921

# 🛡 مشرفون إضافيون (مفصولة بفواصل) — اختياري، المالك مشرف تلقائياً
ADMIN_IDS=

# ─── حدود الاستخدام — 0 تعني بلا حدود ─────────────────────────
# ⏱ الفاصل بين الطلبات لكل مستخدم (ثوانٍ) — 0 = بلا فاصل
REQUEST_COOLDOWN=0
# 📅 الحد الأقصى للتحميلات لكل مستخدم يومياً — 0 = بلا حد
DAILY_DOWNLOAD_LIMIT=0
# 📦 أقصى حجم ملف (ميجابايت) — 0 = تلقائي: 2000 مع الخادم المحلي / 49 بدونه
MAX_FILE_SIZE_MB=0

# 💾 مسار قاعدة البيانات (على Railway وجّهها للـ Volume: /app/data/bot.db)
DATABASE_PATH=./data/bot.db
# 📁 مجلد التنزيلات المؤقت (يُنظف تلقائياً بعد كل عملية)
DOWNLOAD_DIR=./downloads

# ═══════════════════════════════════════════════════════════
#  🚀 بلا حدود نهائياً — خادم Bot API المحلي (حتى 2000 م.بايت/ملف)
# ═══════════════════════════════════════════════════════════
# على Railway: أنشئ خدمة ثانية من صورة Docker: aiogram/telegram-bot-api:latest
# متغيرات تلك الخدمة: API_ID + API_HASH (من https://my.telegram.org) + TELEGRAM_HTTP_PORT=8081
# ثم ضع هنا رابطها الداخلي:
#   TELEGRAM_LOCAL_API=http://<اسم-الخدمة>.railway.internal:8081
# بدونه: الملفات حتى 50 م.بايت (حد تيليجرام العام)
TELEGRAM_LOCAL_API=

# ═══════════════════════════════════════════════════════════
#  🌐 خيارات متقدمة لـ yt-dlp (اختياري)
# ═══════════════════════════════════════════════════════════
# وكيل لو المنصة محجوبة على سيرفرك
# YTDLP_PROXY=socks5://user:pass@host:1080
# ملف كوكيز (Netscape format) للمحتوى المقيد بالعمر من حسابك الشخصي
# YTDLP_COOKIES_FILE=./data/cookies.txt

# ═══════════════════════════════════════════════════════════
#  📊 لوحة التحكم
# ═══════════════════════════════════════════════════════════
# 🔐 كلمة مرور اللوحة — لو فاضية اللوحة مفتوحة (للمعاينة فقط)
#    على Railway عيّنها حتماً وإلا أي حد يقدر يتحكم في البوت!
DASHBOARD_PASSWORD=
# 🌱 بذر بيانات عرض تجريبية عند أول تشغيل (للمعاينة فقط)
SEED_DEMO_DATA=false

# 📝 مستوى اللوجات: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
